# [EN] Copying is normally handled by make setup. This file contains no passwords.
# [PL] Kopiowanie normalnie wykonuje make setup. Ten plik nie zawiera haseł.
LOGIN=__LOGIN__
DOMAIN_NAME=__LOGIN__.42.fr

# [EN] MariaDB identifiers are restricted to letters, digits, and underscores.
# [PL] Identyfikatory MariaDB są ograniczone do liter, cyfr i podkreśleń.
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# [EN] Keep simple values here because setup.sh also reads this file as POSIX shell syntax.
# [PL] Używaj tutaj prostych wartości, ponieważ setup.sh czyta ten plik również jako składnię POSIX shell.
WP_TITLE=Inception
WP_ADMIN_USER=site_owner
WP_ADMIN_EMAIL=site_owner@example.com
WP_USER=content_author
WP_USER_EMAIL=content_author@example.com
WP_USER_ROLE=author
