#Copying is normally handled by make setup. This file contains no passwords.
LOGIN=__LOGIN__
DOMAIN_NAME=__LOGIN__.42.fr

#MariaDB identifiers are restricted to letters, digits, and underscores.
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

#Keep simple values here because setup.sh also reads this file as POSIX shell syntax.
WP_TITLE=Inception
WP_ADMIN_USER=site_owner
WP_ADMIN_EMAIL=site_owner@example.com
WP_USER=content_author
WP_USER_EMAIL=content_author@example.com
WP_USER_ROLE=author
