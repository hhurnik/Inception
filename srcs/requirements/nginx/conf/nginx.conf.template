# NGINX drops worker privileges to the standard Debian web user.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr notice;

# Keep the event configuration small and predictable for the project VM.
events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Container logs go to stdout/stderr so docker logs can collect them.
    access_log /dev/stdout;
    error_log /dev/stderr notice;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 64m;

    server {
        # Port 80 is intentionally absent. HTTPS on 443 is the only entry point.
        listen 443 ssl;
        server_name ${DOMAIN_NAME};

        root /var/www/html;
        index index.php index.html;

        ssl_certificate /etc/nginx/tls/inception.crt;
        ssl_certificate_key /etc/nginx/tls/inception.key;

        # The subject permits only TLS 1.2 and TLS 1.3.
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256';
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;

        # Conservative security headers that do not break the WordPress editor.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        # Health endpoint is independent of PHP and used by the container healthcheck.
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 'ok\n';
        }

        # Serve real files directly and route all other requests through WordPress.
        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        # Never allow the database configuration file to be downloaded or executed directly.
        location = /wp-config.php {
            deny all;
        }

        # Deny hidden files except the conventional ACME directory.
        location ~ /\.(?!well-known/) {
            deny all;
        }

        # PHP files are executed by PHP-FPM in the separate wordpress container.
        location ~ \.php$ {
            try_files $uri =404;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param SCRIPT_NAME $fastcgi_script_name;
            fastcgi_param HTTPS on;
            fastcgi_param HTTP_PROXY '';
            fastcgi_pass wordpress:9000;
            fastcgi_connect_timeout 10s;
            fastcgi_read_timeout 60s;
        }
    }
}
