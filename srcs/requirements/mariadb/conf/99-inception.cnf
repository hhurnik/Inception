#This late-sorting file overrides Debian defaults relevant to the container.
[mariadbd]
user = mysql
pid-file = /run/mysqld/mysqld.pid
socket = /run/mysqld/mysqld.sock
datadir = /var/lib/mysql
port = 3306
bind-address = 0.0.0.0

#Docker DNS uses IP addresses internally, so reverse DNS lookups are unnecessary.
skip-name-resolve

#Use modern Unicode defaults suitable for WordPress.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

#Write operational logs to the container stream collected by Docker.
log-error = /dev/stderr

#Keep durable InnoDB data in separate files within the persistent volume.
default-storage-engine = InnoDB
innodb-file-per-table = 1
max-connections = 100
