#The real environment file is local because it contains machine-specific values.
srcs/.env

# [EN] Secret values must never enter Git.
secrets/*.txt
!secrets/.gitkeep
!secrets/README.md

#Locally generated certificates and keys are not repository content.
*.key
*.pem
*.crt

#Editor, operating-system, and temporary files.
.vscode/
.idea/
.DS_Store
*~
*.swp
*.tmp
